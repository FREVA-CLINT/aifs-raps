# nor does it submit to any jurisdiction.

# This program reads info about your install and tries to find a matching flash attn wheel from
# https://github.com/Dao-AILab/flash-attention/releases

# An example wheel: flash_attn-2.7.0.post1+cu12torch2.5cxx11abiTRUE-cp311-cp311-linux_x86_64.whl

# For this we need to know
#       Cuda version
#       torch version
#       cxx abi TRUE/FALSE
#       python version
#       OS (assume linux)
#       ISA


# the next hundred lines are all just parsing command line args :D

wheel_source="all" # -s|--source #Where to fetch the wheels from. valid options are "all;tridao;naco". "all" will select provider dynamically based on versions
get_wheel_flag=0 # --get-wheel # if you just want the wheel
list_wheels_flag=0 # -l|--list-wheels|--list # lists available wheels
uv_flag=0 # --uv #if you want to install with uv
offline_flag=0 # --offline #if you want to do an offline install (download wheel and quit)
dryrun_flag=0 # --dryrun #if you want to dryrun
force_reinstall_flag=0 # --force-reinstall # if you want to force reinstallation
flash_attn_version='' # -v|--flash-attn-version VERSION #version to install, by default installs the newest
verbose_flag=0 # --verbose #to set +x

#colon after for an arg
lkey="uv offline dryrun force-reinstall flash-attn-version: verbose get-wheel source: list-wheels list"
rkey=$(echo $lkey | perl -pe 's/-//g')

LONG_FLAGS=""
for lf in $(echo "$lkey $rkey" | perl -pe 's/\s+/\n/g'| sort -u)
do
    LONG_FLAGS="$LONG_FLAGS -l $lf"
done

FLAGS="v:s:l"

OPTS=`getopt -o $FLAGS $LONG_FLAGS -- "$@"`

if [[ $? -ne 0 ]] ; then
    echo "${cmd}: (Error) Invalid or unsupported options from 'getopt'" >&2
    exit 1
fi

trueargs=$(echo "$OPTS" | perl -pe "s/^\s+//; s/(--\S+)\s+'/\${1}=/g; s/'//g; s/--\s*$//")
abort=no

eval set -- "$OPTS"

while true
do
    case "$1" in
    -v|--flash-attn-version) flash_attn_version=$2; shift 2;;
    -s|--source) wheel_source=$2; shift 2;;
    --uv) uv_flag=1; shift;;
    --dryrun) dryrun_flag=1; shift;;
    --offline) offline_flag=1; shift;;
    --verbose) verbose_flag=1; shift;;
    --get-wheel) get_wheel_flag=1; shift;;
    -l|--list|--list-wheels) list_wheels_flag=1; shift;;
    --force-reinstall) force_reinstall_flag=1; shift;;
        --) shift; break;;
        *) echo "DEBUG: 1=${1:-}"; echo "DEBUG: 2=${2:-}"; abort=yes; break;;
    esac
done

if [[ $abort = yes ]] ; then
    echo "${cmd}: (Error) Invalid command line arguments : $cmdargs" >&2
    ((errcnt += 1))
fi

quiet="-q" #by default pip and wget is silenced
if [[ $verbose_flag -eq 1 ]]; then
	set -x
	quiet="" #unsilence pip and wget when running in verbose mode
fi

if command -v python3 &> /dev/null; then
	PYTHON_CMD="python3"
else
	PYTHON_CMD="python"
fi

version_gt() {
	[ "$(printf "%s\n%s\n" "$2" "$1" | sort -V | tail -n 1)" = "$1" ] && [ "$1" != "$2" ]
}

printf "importing torch to parse config. could take a min...\n"
torch_info="$($PYTHON_CMD - <<'PY'
import platform
import re
import sys

import torch

cfg = torch.__config__.show()

def detect_cuda_major() -> str:
    cuda_raw = getattr(torch.version, "cuda", None)
    if cuda_raw:
        return str(cuda_raw).split(".")[0]

    patterns = [
        r"CUDA_VERSION\s*=\s*([0-9]+)",
        r"CUDA used to build PyTorch:\s*([0-9]+)",
    ]
    for pat in patterns:
        m = re.search(pat, cfg, flags=re.IGNORECASE)
        if m:
            return m.group(1)

    # Fallback for builds tagged like '2.10.0+cu128'
    m = re.search(r"\+cu([0-9]{2,3})\b", str(torch.__version__))
    if m:
        token = m.group(1)
        if len(token) == 3:
            return token[:2]
        return token

    return ""

def detect_cuda_built() -> int:
    try:
        return 1 if torch.backends.cuda.is_built() else 0
    except Exception:
        return 0

hip_raw = getattr(torch.version, "hip", None) or ""
cuda_major = detect_cuda_major()
cuda_built = detect_cuda_built()

torch_raw = str(torch.__version__).split("+")[0]
m = re.match(r"^([0-9]+)\.([0-9]+)", torch_raw)
if not m:
    raise RuntimeError(f"could not parse torch version from '{torch_raw}'")
torch_short = f"{m.group(1)}.{m.group(2)}"

abi_attr = getattr(getattr(torch, "_C", object()), "_GLIBCXX_USE_CXX11_ABI", None)
if abi_attr is None:
    m = re.search(r"ABI=([01])", cfg)
    if not m:
        raise RuntimeError("could not determine CXX11 ABI from torch")
    abi = "TRUE" if m.group(1) == "1" else "FALSE"
else:
    abi = "TRUE" if bool(abi_attr) else "FALSE"

python_tag = f"cp{sys.version_info.major}{sys.version_info.minor}"
os_name = "linux" if sys.platform.startswith("linux") else sys.platform
isa = platform.machine()

print(f"cuda_version={cuda_major}")
print(f"cuda_built={cuda_built}")
print(f"hip_version={hip_raw}")
print(f"torch_version={torch_short}")
print(f"ABI={abi}")
print(f"python_tag={python_tag}")
print(f"os={os_name}")
print(f"isa={isa}")
PY
)" || {
	printf "Error. could not import torch or parse torch config. Have you activated your python environment?\nexiting..."
	exit 1
}

while IFS='=' read -r key value; do
	case "$key" in
		cuda_version) cuda_version="$value" ;;
		cuda_built) cuda_built="$value" ;;
		hip_version) hip_version="$value" ;;
		torch_version) torch_version="$value" ;;
		ABI) ABI="$value" ;;
		python_tag) python_tag="$value" ;;
		os) os="$value" ;;
		isa) isa="$value" ;;
	esac
done <<< "$torch_info"

if [[ -n "${FLASH_ATTN_CUDA_MAJOR:-}" ]]; then
	cuda_version="$FLASH_ATTN_CUDA_MAJOR"
	printf "Warning. overriding detected CUDA major with FLASH_ATTN_CUDA_MAJOR=%s\n" "$cuda_version"
fi

if [[ -z "${cuda_version:-}" ]]; then
	if [[ -n "${hip_version:-}" ]]; then
		printf "Error. torch appears to be a ROCm build (HIP=%s), not CUDA.\n" "$hip_version"
		printf "flash-attn CUDA wheels are incompatible with ROCm torch.\nexiting...\n"
	elif [[ "${cuda_built:-0}" -eq 0 ]]; then
		printf "Error. torch appears to be CPU-only (CUDA not built in).\n"
		printf "Install a CUDA-enabled torch build first, then rerun this script.\nexiting...\n"
	else
		printf "Error. Could not detect CUDA version from torch despite CUDA support.\n"
		printf "Try setting FLASH_ATTN_CUDA_MAJOR=<major> (for example 12) and rerun.\nexiting...\n"
	fi
	exit 1
fi

printf " +        cu$cuda_version\n"
printf " +        torch v$torch_version\n"
printf " +        ABI$ABI\n"
printf " +        $python_tag\n"

printf " +        $os\n"

printf " +        $isa\n"

#check for internet
# if no, just run offline mode
wget $quiet --spider http://google.com
if [ ! $? -eq 0 ]; then
        printf "Warning! no internet detected (unable to ping 'http://google.com')\nRunning in offline mode instead\n"
        offline_flag=1
fi


#select source, if source is all
# aarch64 will go to naco
# and any torch builds newer then 2.6.0
if  [[ $wheel_source == "all" ]]; then
wheel_source="tridao"
if  [[ $isa == "aarch64" ]] || version_gt "$torch_version" "2.6" ; then
wheel_source="naco"
fi
printf " +        source '$wheel_source'\n"
fi

if [[ $wheel_source == "naco" ]]; then

	#Hardcode abi false, I dont have wheels with ABI true yet
	ABI=FALSE
	tag="v0.1-alpha"
#https://github.com/cathalobrien/get-flash-attn/releases/download/v0.1-alpha/flash_attn-2.7.4+cu12torch2.6cxx11abiFALSE-cp311-cp311-linux_x86_64.whl
	repo=cathalobrien/get-flash-attn

elif  [[ $wheel_source == "tridao" ]]; then

	tag=v${flash_attn_version}
	repo=Dao-AILab/flash-attention

else
printf "Unkown wheel source '$wheel_source'. Exiting...\n"
exit 0
fi

#if a version was not given with '-v <version>'
#try to find the newest match for your given env
if [[ ${flash_attn_version} == "" ]]; then
	wheels=$(curl -s -L "https://api.github.com/repos/${repo}/releases" | jq -r ".[].assets[].name" | grep "torch${torch_version}cxx11abi${ABI}-${python_tag}" || true)
	if [[ -z "$wheels" ]]; then
		printf "\nError no matching wheel found for your environment\nrun '%s -l' to list available wheels. Exiting...\n" "$0"
		exit 0
	fi
	# Pick newest wheel by version-sort over filenames.
	# TODO should not automatically pick v3 wheels
	flash_attn_wheel=$(echo "$wheels" | sort -V | tail -n 1)

	#get the version from the wheel
	# we need it for the tag in the case of tridao, adn to import to test the install at the end
	tmp="${flash_attn_wheel#*flash_attn-}" # Remove prefix "flash_attn-"
	flash_attn_version="${tmp%%+*}" # Remove suffix starting with "+"

	if [[ $wheel_source == "tridao" ]]; then
		 tag=v${flash_attn_version}
	fi
else
	#trust that a valid version was given, we will find out soon enough
	flash_attn_wheel="flash_attn-${flash_attn_version}+cu${cuda_version}torch${torch_version}cxx11abi${ABI}-${python_tag}-${python_tag}-${os}_${isa}.whl"
fi

if [[ -z "${flash_attn_wheel:-}" ]]; then
	printf "Error. Wheel name resolved to empty string. Exiting...\n"
	exit 1
fi

url="https://github.com/${repo}/releases/download/$tag/$flash_attn_wheel"
if [[ $list_wheels_flag -eq 1 ]]; then
	if [[ "${offline_flag:-0}" -eq 1 ]]; then
		printf "\ncant list available wheels without internet. exiting..."
		exit 0
	fi
	printf "\nThe following wheels are available from the source '$wheel_source':\n"
 	curl -s -L "https://api.github.com/repos/${repo}/releases" | jq -r '.[].assets[].name'
	exit 0
fi

printf " =>       $flash_attn_wheel\n"

if [[ "${DRYRUN:-0}" -eq 1 ]]  || [[ $dryrun_flag -eq 1 ]] ; then
        printf "\nDryrun! Printing commands instead:\n"
		printf "         wget $url\n"
		printf "         pip install $flash_attn_wheel\n"
		exit 0
fi

if [[ "${OFFLINE:-0}" -eq 1 ]] || [[ "$offline_flag" -eq 1 ]]; then
        printf "\nOffline! To install flash-attn, please run 'wget ...' on a system with internet and copy it over and then run 'pip install':\n"
        printf "          wget $url\n"
        printf "          scp $flash_attn_wheel <remote>:\n"
	printf "	  ssh <remote>\n"
        printf "          pip install $flash_attn_wheel\n"
	exit 0
fi

printf "\nRetrieving $flash_attn_wheel...\n"
if [[ ! $url == "" ]]; then 
wget $quiet $url 2>&1 > /dev/null ||{
	printf "url not found! Maybe '$flash_attn_wheel' is not a supported configuration :(\nrun '%s -l' to list available wheels\nexiting...\n" "$0"
	exit 0
}
fi

if [[ $get_wheel_flag -eq 1 ]]; then
	printf "Wheel is saved at $PWD/$flash_attn_wheel\n"
	exit 0
fi

prefix=""
#first case is legacy, 2nd case is command line arg
if [[ ! $UV == "" ]] || [[ $uv_flag -eq "1" ]] ; then
	prefix="uv"
fi

reinstall=""
if [[ $force_reinstall_flag -eq 1 ]]; then
	reinstall="--force-reinstall"
fi
printf "Installing $flash_attn_wheel...\n"
$prefix pip install $quiet $reinstall --no-cache-dir --no-deps $flash_attn_wheel
rm $flash_attn_wheel

# [_-] because the module name is not consistent
pip list | grep flash[_-]attn > /dev/null  2>get-flash-attn.err
install_status=$?
if [[ $install_status == "0" ]]; then
	printf "Install succeeded\n"
else
	printf "Install failed. Your error is saved in 'get-flash-attn.err'\n"
	exit 0 
fi

if [[ $wheel_source == "tridao" ]] && version_gt "$torch_version" "2.6" ; then
	printf "\nWarning. torch version '$torch_version' is 2.7 or higher. Due to changes in how the wheels are built, you might need to update your GCC for flash-attn before running\n"
	printf "On Atos: 		'export LD_LIBRARY_PATH=/usr/local/apps/gcc/12.2.0/lib64/:\$LD_LIBRARY_PATH'\n"
	printf "On Leonardo: 	'module load gcc/12.2.0'\n"
fi

printf "\nTesting flash attention install by importing it.\n"
flash_attn_major_version=${flash_attn_version:0:1} #first letter, either 2 or 3

if [[ $flash_attn_major_version -eq 2 ]]; then
	import_cmd="import flash_attn"
elif [[ $flash_attn_major_version -eq 3 ]]; then
	import_cmd="import flash_attn_interface"
else
	printf "Unknown flash-attn major version '$flash_attn_major_version'. Can't test installation by importing. exiting...\n"
	exit 0

fi

$PYTHON_CMD -c "$import_cmd" 2>get-flash-attn.err
import_status=$? 

if [[ $import_status == "0" ]]; then
	printf "Import succeeded\n"
else
	printf "Import failed. Your error is saved in 'get-flash-attn.err'\n"
	exit 0
fi
